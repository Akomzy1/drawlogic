  "rules": [
    {
      "id": "generic-geometry-closure",
      "profile": {
        "id": "generic",
        "version": "0.1.0"
      },
      "state": "unverified",
      "signer": null,
      "category": "geometry",
      "document": null,
      "applies_to": {
        "drawing_type": "detail"
      },
      "condition": {
        "cmp": {
          "left": {
            "measure": "is_closed",
            "args": {
              "scope": "all_objects"
            }
          },
          "op": "==",
          "right": {
            "value": true
          }
        }
      },
      "condition_text": "is_closed(scope=all_objects) == true",
      "severity": "flag",
      "auto_fix": null,
      "message": "Every drawn element should be a closed shape.",
      "why": "Gaps between lines make quantities, hatching and renders wrong, and hide where one material ends and the next begins.",
      "judgement": false,
      "modes": [
        "draft",
        "learn"
      ]
    },
    {
      "id": "generic-dimension-chain",
      "profile": {
        "id": "generic",
        "version": "0.1.0"
      },
      "state": "unverified",
      "signer": null,
      "category": "dimensions",
      "document": null,
      "applies_to": {
        "drawing_type": "detail"
      },
      "condition": {
        "cmp": {
          "left": {
            "measure": "count",
            "args": {
              "of": "dimension_conflicts"
            }
          },
          "op": "==",
          "right": {
            "value": 0
          }
        }
      },
      "condition_text": "count(of=dimension_conflicts) == 0",
      "severity": "flag",
      "auto_fix": null,
      "message": "Dimension chains should add up to their overall dimensions.",
      "why": "When a chain of dimensions does not add up, someone on site builds to the wrong number.",
      "judgement": false,
      "modes": [
        "draft",
        "learn"
      ]
    },
    {
      "id": "generic-symbol-legend",
      "profile": {
        "id": "generic",
        "version": "0.1.0"
      },
      "state": "unverified",
      "signer": null,
      "category": "symbols",
      "document": null,
      "applies_to": {
        "drawing_type": "detail"
      },
      "condition": {
        "cmp": {
          "left": {
            "measure": "count",
            "args": {
              "of": "symbols_without_legend"
            }
          },
          "op": "==",
          "right": {
            "value": 0
          }
        }
      },
      "condition_text": "count(of=symbols_without_legend) == 0",
      "severity": "flag",
      "auto_fix": null,
      "message": "Every symbol used should appear in the legend.",
      "why": "A symbol nobody can look up is a guess waiting to happen on site.",
      "judgement": false,
      "modes": [
        "draft",
        "learn"
      ]
    },
    {
      "id": "generic-annotation",
      "profile": {
        "id": "generic",
        "version": "0.1.0"
      },
      "state": "unverified",
      "signer": null,
      "category": "annotation",
      "document": null,
      "applies_to": {
        "drawing_type": "detail"
      },
      "condition": {
        "cmp": {
          "left": {
            "measure": "count",
            "args": {
              "of": "materials_without_annotation"
            }
          },
          "op": "==",
          "right": {
            "value": 0
          }
        }
      },
      "condition_text": "count(of=materials_without_annotation) == 0",
      "severity": "flag",
      "auto_fix": null,
      "message": "Every material shown should carry an annotation.",
      "why": "An unlabelled layer leaves the builder to guess what it is made of.",
      "judgement": false,
      "modes": [
        "draft",
        "learn"
      ]
    },
    {
      "id": "generic-thermal-line",
      "profile": {
        "id": "generic",
        "version": "0.1.0"
      },
      "state": "unverified",
      "signer": null,
      "category": "thermal",
      "document": null,
      "applies_to": {
        "drawing_type": "detail"
      },
      "condition": {
        "cmp": {
          "left": {
            "measure": "is_continuous",
            "args": {
              "path": "thermal_line"
            }
          },
          "op": "==",
          "right": {
            "value": true
          }
        }
      },
      "condition_text": "is_continuous(path=thermal_line) == true",
      "severity": "flag",
      "auto_fix": null,
      "message": "The insulation line should be drawn continuous through the detail.",
      "why": "Breaks in the insulation line are where heat escapes and condensation forms.",
      "judgement": false,
      "modes": [
        "draft",
        "learn"
      ]
    },
    {
      "id": "generic-drainage-path",
      "profile": {
        "id": "generic",
        "version": "0.1.0"
      },
      "state": "unverified",
      "signer": null,
      "category": "drainage",
      "document": null,
      "applies_to": {
        "drawing_type": "detail"
      },
      "condition": {
        "cmp": {
          "left": {
            "measure": "count",
            "args": {
              "of": "drainage_paths"
            }
          },
          "op": ">=",
          "right": {
            "value": 1
          }
        }
      },
      "condition_text": "count(of=drainage_paths) >= 1",
      "severity": "flag",
      "auto_fix": null,
      "message": "The detail should show where water drains to.",
      "why": "Water that has no drawn way out tends to end up inside the building.",
      "judgement": false,
      "modes": [
        "draft",
        "learn"
      ]
    }
  ],
