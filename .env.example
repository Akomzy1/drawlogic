# Copy to .env and fill in. .env is never committed.

# --- site/tests (site fidelity tests, TESTING.md layer 5a) ---
# Where test output and reports go. Keep it OUTSIDE OneDrive or any synced folder:
# writing test output into a synced folder slows a full run from minutes to hours.
REPORTS_DIR=C:/Users/<you>/AppData/Local/drawlogic/site-test-reports
# The site under test (its public/media/manifest.json and its out/ static export). Defaults to ./site.
# SITE_DIR=../drawlogic-engine/site
# Test an already-running server instead of serving SITE_DIR/out.
# SITE_URL=http://127.0.0.1:4179
# Set to true at launch: crawlers are then expected to be allowed and the Lighthouse is-crawlable audit is enforced.
# SITE_LAUNCHED=false
