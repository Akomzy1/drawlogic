{
  "name": "@drawlogic/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Drawlogic contracts: JSON Schemas, generated types, examples, copy and model config.",
  "scripts": {
    "validate": "node scripts/validate.mjs",
    "gen:ts": "node scripts/gen-ts.mjs",
    "check:generated": "node scripts/gen-ts.mjs --check",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "json-schema-to-typescript": "16.0.0",
    "typescript": "5.9.3"
  }
}
