    {
      "id": "gb-eng-roof-upstand-150",
      "profile": { "id": "gb-eng-residential", "version": "1.3.0" },
      "state": "verified",
      "signer": { "name": "J. Smith", "credential": "CIAT 12345", "jurisdiction": "England", "verification_level": "verified", "signed_at": "2026-09-02T10:00:00Z" },
      "category": "moisture",
      "document": { "ref": "BS 6229", "edition": "2018" },
      "applies_to": { "drawing_type": "detail", "detail_type": "parapet", "object_class": "upstand" },
      "condition": { "cmp": { "left": { "field": "height" }, "op": ">=", "right": { "value": 150, "unit": "mm" } } },
      "condition_text": "upstand.height >= 150 mm",
      "severity": "flag",
      "auto_fix": { "action": "min", "field": "height", "value": 150 },
      "message": "Membrane upstand should be at least 150 mm above the finished roof surface.",
      "why": "Water can pond or be blown against the parapet. The membrane has to turn up high enough that it does not get over the top of the upstand and into the wall.",
      "judgement": false,
      "modes": ["draft", "learn"],
      "requires_inputs": ["height"]
    },
    {
      "id": "gb-eng-L-4.2",
      "profile": { "id": "gb-eng-residential", "version": "1.3.0" },
      "state": "unverified",
      "signer": null,
      "category": "thermal",
      "document": { "ref": "Approved Document L" },
      "applies_to": { "drawing_type": "detail", "detail_type": "parapet", "object_class": "insulation" },
      "condition": { "cmp": { "left": { "measure": "is_continuous", "args": { "from_class": "insulation", "to_class": "roof_insulation" } }, "op": "==", "right": { "value": true } } },
      "condition_text": "is_continuous(from_class=insulation, to_class=roof_insulation) == true",
      "severity": "flag",
      "auto_fix": null,
      "message": "Wall insulation should be continuous with the roof insulation at the parapet.",
      "why": "A gap in the insulation where the wall meets the roof is a cold spot. Warm, damp air can condense there.",
      "judgement": false,
      "modes": ["draft", "learn"]
    }
  ],
