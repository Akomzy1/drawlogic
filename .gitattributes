# Bundled prototype exports are byte-exact artefacts: never convert line endings (the site tests pin their sha256).
design/prototype/*.html -text
# Contracts: hashes, generated types and CI staleness checks assume LF everywhere.
contracts/** text eol=lf
# Render fixtures: build.py --check compares generated JSON byte for byte; images are binary.
fixtures/** text eol=lf
fixtures/**/*.png binary
# Profiles: profiles.tools --check compares the JSON byte for byte.
profiles/** text eol=lf
